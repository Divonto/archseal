{
  "version": 1,
  "roots": ["example/src"],
  "layers": {
    "domain": ["example/src/domain"],
    "infrastructure": ["example/src/infrastructure"]
  },
  "rules": [
    {
      "from": "domain",
      "deny": ["infrastructure"]
    }
  ],
  "aliases": {
    "@domain/*": "example/src/domain/*",
    "@infra/*": "example/src/infrastructure/*"
  },
  "forbid_cycles": true
}
